# Tunimoto frontend production environment variables
# Deployment target: Vercel
# Only public browser-safe variables are allowed here.

# REQUIRED
# Absolute HTTPS API base URL, including the /api suffix.
VITE_API_BASE_URL=https://api.tunimoto.tn/api

# OPTIONAL
# Public Cloudflare Turnstile site key.
# Required only if Turnstile stays enabled on login / register / forgot-password pages.
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=
