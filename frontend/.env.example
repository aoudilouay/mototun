# Tunimoto frontend local / general environment variables
# Only public browser-safe variables are allowed here.

# REQUIRED for production builds. Optional in local dev because /api can be proxied.
VITE_API_BASE_URL=https://api.example.com/api

# OPTIONAL for local dev only.
# If omitted, Vite dev proxy falls back to the origin derived from VITE_API_BASE_URL,
# then to http://localhost:5050.
VITE_BACKEND_ORIGIN=http://localhost:5050

# OPTIONAL
# Public Cloudflare Turnstile site key.
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=
