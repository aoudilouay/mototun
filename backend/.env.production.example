# Tunimoto backend production environment variables
# Deployment target: Render
# Preferred names are SCREAMING_SNAKE_CASE with ASP.NET-style __ nesting.
# Legacy names remain supported in code for backward compatibility.

ASPNETCORE_ENVIRONMENT=Production

# DATABASE - REQUIRED
# Example: Server=tcp:your-server.database.windows.net,1433;Initial Catalog=your-db;Persist Security Info=False;User ID=your-user;Password=your-password;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
DATABASE__DEFAULT_CONNECTION=

# AUTH / JWT - REQUIRED
# Use a random secret with at least 32 characters.
JWT_SETTINGS__SECRET_KEY=
JWT_SETTINGS__ISSUER=MototunAPI
JWT_SETTINGS__AUDIENCE=MototunClient
JWT_SETTINGS__EXPIRATION_IN_DAYS=7

# AUTH / URLS - REQUIRED
# Public frontend reset-password URL.
AUTH_SETTINGS__PASSWORD_RESET_URL=https://www.tunimoto.tn/reset-password
AUTH_SETTINGS__PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# API / CORS - REQUIRED
# Exact frontend origins only. Add more indices if needed.
CORS__ALLOWED_ORIGINS__0=https://www.tunimoto.tn
CORS__ALLOWED_ORIGINS__1=https://tunimoto.tn

# STORAGE - REQUIRED when Azure Blob is enabled for private dossier files
AZURE_BLOB__CONNECTION_STRING=
AZURE_BLOB__DOCUMENTS_CONTAINER=client-portal-docs
AZURE_BLOB__AVATARS_CONTAINER=avatars
AZURE_BLOB__INVOICE_SETTINGS_CONTAINER=invoice-pdf-settings

# EMAIL / RESEND - REQUIRED
RESEND__BASE_URL=https://api.resend.com
RESEND__API_KEY=
RESEND__SENDER_EMAIL=no-reply@send.tunimoto.tn
RESEND__SENDER_NAME=Tunimoto
RESEND__ALLOW_DEVELOPMENT_FALLBACK=false

# SECURITY / TURNSTILE - OPTIONAL
# Enable only if the frontend auth forms use Turnstile.
CLOUDFLARE__TURNSTILE__ENABLED=true
CLOUDFLARE__TURNSTILE__SECRET_KEY=
CLOUDFLARE__TURNSTILE__VERIFY_ENDPOINT=https://challenges.cloudflare.com/turnstile/v0/siteverify

# OPTIONAL INTEGRATION / OCR
DOCUMENT_OCR__ENABLED=false
DOCUMENT_OCR__BASE_URL=
DOCUMENT_OCR__ANALYZE_PATH=/api/ocr/analyze
DOCUMENT_OCR__API_KEY=
DOCUMENT_OCR__TIMEOUT_SECONDS=30
DOCUMENT_OCR__MIN_CONFIDENCE=0.65

# OPTIONAL BACKGROUND JOBS / REMINDERS
STUCK_DOSSIER_REMINDERS__ENABLED=false
STUCK_DOSSIER_REMINDERS__SCAN_INTERVAL_MINUTES=30
STUCK_DOSSIER_REMINDERS__STUCK_AFTER_HOURS=24
STUCK_DOSSIER_REMINDERS__REPEAT_EVERY_HOURS=24
STUCK_DOSSIER_REMINDERS__MAX_INVOICES_PER_RUN=200
STUCK_DOSSIER_REMINDERS__ENABLE_EMAIL=true
STUCK_DOSSIER_REMINDERS__ENABLE_SMS=false
STUCK_DOSSIER_REMINDERS__ENABLE_WHATSAPP=false
STUCK_DOSSIER_REMINDERS__SMS_WEBHOOK_URL=
STUCK_DOSSIER_REMINDERS__WHATSAPP_WEBHOOK_URL=

# OPTIONAL / DANGEROUS
# Keep disabled in production except for a one-time controlled bootstrap.
ADMIN_BOOTSTRAP__ENABLED=false
ADMIN_BOOTSTRAP__EMAIL=
ADMIN_BOOTSTRAP__PASSWORD=
ADMIN_BOOTSTRAP__FULL_NAME=Platform Admin
