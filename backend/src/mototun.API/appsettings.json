{
  "ConnectionStrings": {
    "DefaultConnection": "__SET_IN_ENV__"
  },
  "JwtSettings": {
    "SecretKey": "__SET_IN_ENV__",
    "Issuer": "MototunAPI",
    "Audience": "MototunClient",
    "ExpirationInDays": 7
  },
  "AuthSettings": {
    "PasswordResetUrl": "__SET_IN_ENV__",
    "PasswordResetTokenExpiryMinutes": 30
  },
  "Cloudflare": {
    "Turnstile": {
      "Enabled": true,
      "SecretKey": "",
      "VerifyEndpoint": "https://challenges.cloudflare.com/turnstile/v0/siteverify"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Resend": {
    "BaseUrl": "https://api.resend.com",
    "ApiKey": "__SET_IN_ENV__",
    "SenderEmail": "__SET_IN_ENV__",
    "SenderName": "Mototun",
    "AllowDevelopmentFallback": false
  },
  "DocumentOcr": {
    "Enabled": false,
    "BaseUrl": "",
    "AnalyzePath": "/api/ocr/analyze",
    "ApiKey": "__SET_IN_ENV_IF_ENABLED__",
    "TimeoutSeconds": 30,
    "MinConfidence": 0.65
  },
  "InvoicePdf": {
    "BrandTagline": "Vente et reparation motos",
    "DocumentTitle": "FACTURE",
    "AccentColorHex": "#1F2937",
    "BodyTextColorHex": "#111827",
    "MutedTextColorHex": "#6B7280",
    "DividerColorHex": "#E5E7EB",
    "TableHeaderBackgroundHex": "#F9FAFB",
    "TableHeaderTextColorHex": "#1F2937",
    "TableBorderColorHex": "#E5E7EB",
    "TableAlternateRowColorHex": "#FFFFFF",
    "PageBackgroundHex": "#FFFFFF",
    "ServiceTitle": "Vente de motocycle"
  },
  "StuckDossierReminders": {
    "Enabled": false,
    "ScanIntervalMinutes": 30,
    "StuckAfterHours": 24,
    "RepeatEveryHours": 24,
    "MaxInvoicesPerRun": 200,
    "EnableEmail": true,
    "EnableSms": false,
    "EnableWhatsApp": false,
    "SmsWebhookUrl": "",
    "WhatsAppWebhookUrl": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*"
}
